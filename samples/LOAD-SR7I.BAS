10 REM Load interlaced SCREEN 7 image (SR: without embedded palette)
20 REM Requires: NONAME.PAL, NONAME.R70 (page 0) and NONAME.R71 (page 1)
30 REM MSX2 with 128K VRAM
40 SCREEN 7
50 BLOAD"NONAME.PAL",S
60 COLOR=RESTORE
70 BLOAD"NONAME.R70",S
80 SET PAGE 1,1
90 BLOAD"NONAME.R71",S
100 SET PAGE 0,0
110 VDP(9)=VDP(9) OR &H0C
120 IF INKEY$="" GOTO 120
130 VDP(9)=VDP(9) AND &HF3
140 SCREEN 0
150 END
